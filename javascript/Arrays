}
function merge(arr1,arr2,m,n){
  let i=0
  let j=0
  let k=0
  // console.log(m,n)
  let c = new Array(m+n)
  // console.log(i < arr1.length && j < arr2.length)
  while(i < m && j < n){
    if(arr1[i] < arr2[j]){
      c[k++] = arr1[i++]
    }else{
      c[k++] =arr2[j++]
    }
  }  
  for(;i < m;i++){
    c[k] = arr1[i]
    k++
   
  }
   for(;j < n;j++){
    c[k] = arr2[j]
     k++
  }
  return c
}
