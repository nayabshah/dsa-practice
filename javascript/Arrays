class MyArray {
    constructor(size) {
       this.length = 0;
      this.size = size;
      this.A = new Array(size);
    }

    append(value) {
        if (this.length < this.size) {
            this.A[this.length] = value;
            this.length++;
            return this.length
        }
    }

    insert(idx, value) {
        if (idx >= 0 && idx <= this.length && this.length < this.size) {
            for (let i = this.length; i > idx; i--) {
                this.A[i] = this.A[i - 1];
            }

            this.A[idx] = value;
            this.length++;
        }
    }

    delete(idx) {
        if (idx >= 0 && idx < this.length) {
            for (let i = idx; i < this.length - 1; i++) {
                this.A[i] = this.A[i + 1];
            }

            this.length--;
        }
    }
    swap(x,y){
      let temp = this.A[x]
      this.A[x]=this.A[y]
      this.A[y] = temp
    }
    search(value) {
        for (let i = 0; i < this.length; i++) {
            if (this.A[i] === value) {
              if (i > 0) {
                this.swap(i,i-1)
              }
              return i;
            }
        }

        return -1;
    }

    display() {
        for (let i = 0; i < this.length; i++) {
            console.log(this.A[i]);
        }
    }
    binSearch(key){
      let l=0
      let h=this.length-1
      while(l<=h){
        let mid = Math.floor((l+h)/2)
        if(key === this.A[mid]){
          return mid
        }else if(this.A[mid] > key){
          h=mid-1
        }else{
          l=mid+1
        }
      }
      return -1
    }
  get(idx){
    if(idx>=0 && idx<this.length){
      return this.A[idx]
    }
    return -1
  }
  set(idx,value){
    if(idx>=0 && idx<this.length){
      this.A[idx] = value
    }
  }
  max(){
    let mx = this.A[0]
    for(let i=1;i<this.length;i++){
      if(this.A[i]>mx){
        mx=this.A[i]
      }
    }
    return mx
  }
  min(){
    let mn = this.A[0]
    for(let i=1;i<this.length;i++){
      if(this.A[i]<mn){
        mn=this.A[i]
      }
    }
    return mn
  }
  sum(){
    let sm=0
    for(let i=0;i<this.length;i++){
      sm+=this.A[i]
    }
    return sm
  }
  avg(){
    
    return this.sum()/(this.length)
  }
  reverse(){
    let l=0
    let r = this.length-1
    while(l<=r){
      this.swap(l,r)
      l++
      r--
    }
  }
  isSorted(){
    for(let i=0;i<this.length-1;i++){
      if(this.A[i]>this.A[i+1]){
        return false
      }
    }
    return true
  }
  insertedSorted(value){
    if(this.isSorted()){
      let i = this.length-1
      while(this.A[i] > value){
        this.A[i + 1] = this.A[i];
        i--
      }
      this.A[i+1] = value
      this.length++
    }
  }
  negativeLeft(){
    let i=0
    let j=this.length-1
    while(i<j){
      while(this.A[i]<0){i++}
      while(this.A[j]>=0){j--}
      if(i<j){
        this.swap(i,j)
      }
    }
  }
  // rSum(A,n){
