let str = "Hello World"

function reverseStr(str){
  let reversedStr=''
  for(let i=str.length-1;i>=0;i--){
    reversedStr+=str[i]
  }
  return reversedStr
}
// ASCII CODE A-Z = 65-90, a-z=97-122 difference between lower case to upper case latter 32
function toLowerCase(str){
  let result = ''
  for(let i=0;i<str.length;i++){
    let charCode = str.charCodeAt(i)
    if(charCode >= 65 && charCode<=90){
      result += String.fromCharCode(charCode+32)
    }
    else{
      result+=str[i]
    }
  }
  return result
}

function toUpperCase(str){
  let result = ''
  for(let i=0;i<str.length;i++){
    let charCode = str.charCodeAt(i)
    if(charCode >= 97 && charCode<=122){
      result += String.fromCharCode(charCode-32)
    }
    else{
      result+=str[i]
    }
  }
  return result
}
function wordCount(str){
  let result =1
  for(let i=0;i<str.length;i++){
    if(str[i]===' ' && str[i-1] != ' '){
      result++
    }
  }
  return result
}
function stringLength(str){
   let result =1
  let i=0
  while(str[i]){
    result++
    i++
  }
  return result
}

function strCamparing(str1,str2){
  let i=j=0
  while (str1[i] && str2[j]){
   
    if(str1[i] !== str2[j]){
      break
    } 
    i++
    j++
  }
  if(str1[i] === str2[j]){
    return 'Equal'
  }else if(str1[i] < str2[j]){
    return `${str1} is small`
  }else{
    return `${str1} is big`
  }
}
function isPalindrome(str){
  const reversed = reverseStr(str)
  if(reversed === str){
    return true
  }
  return false
}


